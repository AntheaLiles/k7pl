# Describes the specification archived on Zenodo (see zenodo.json).
# At each specification release (tag spec-vX.Y.Z): update `version` and `date-released`
# (the implementation has its own version, in lakefile.lean); after the first Zenodo
# publication, add the concept DOI (printed in the release job summary):
#
# identifiers:
#   - type: doi
#     value: "10.5281/zenodo.xxxxxx"
#     description: "Concept DOI (toutes les versions)"
cff-version: 1.2.0
message: "Citez ce travail comme suit."
title: "K7PL - KonSept Programming Language's Specification"
version: "0.0.0"
authors:
  - family-names: "Pierre"
    given-names: "Cyprien"
    orcid: "https://orcid.org/0009-0009-9040-6795"
    affiliation: "LAMIH UMR CNRS 8201"
license: "CC-BY-4.0"
repository-code: "https://github.com/AntheaLiles/k7pl"
url: "https://anthealiles.github.io/k7pl/"
abstract: >-
  Spécification du langage de programmation K7PL, écrite en Verso et vérifiée
  par Lean 4 contre son implémentation de référence (Mathlib, CSLib).
keywords:
  - K7PL
  - programming language
  - language specification
  - formal semantics
  - Lean 4
  - Verso
