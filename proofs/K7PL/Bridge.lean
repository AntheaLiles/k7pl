import K7PL2Lean.Rewrite

/-!
One-way bridges from the root computational rules of the experimental K7PL
subset to the complete-configuration relation generated by Klean.

Klean emits transitions over complete configurations and uses explicit
subsort injections. The initial-state encoders make the intended representation
explicit: compound expressions are injected as SortK7Exp, while integer and
Boolean results are injected at their minimal generated sorts. These encodings
mirror the constructor types emitted in the generated Rewrite.lean.
-/

namespace K7PL.Bridge

/-- Embed a compound K7PL expression in an initial K configuration. -/
def initialState (e : SortK7Exp) : SortGeneratedTopCell :=
  { k := { val := SortK.kseq ((@Inj.inj SortK7Exp SortKItem) e) SortK.dotk }
    generatedCounter := { val := 0 } }

/-- Embed an integer result at its minimal K subsort, as Klean does. -/
def initialIntState (n : SortInt) : SortGeneratedTopCell :=
  { k := { val := SortK.kseq ((@Inj.inj SortInt SortKItem) n) SortK.dotk }
    generatedCounter := { val := 0 } }

/-- The labelled K addition rule is a constructor of generated Rewrites. -/
theorem add_root_is_klean_rewrite (i j : SortInt) :
    Rewrites
      (initialState
        (SortK7Exp.k7Add
          ((@Inj.inj SortInt SortK7Exp) i)
          ((@Inj.inj SortInt SortK7Exp) j)))
      (initialIntState (i + j)) := by
  exact Rewrites.k7AddEval
    (I := i) (J := j) (_Val0 := i + j)
    (_DotVar0 := ⟨0⟩) (_DotVar1 := SortK.dotk)
    (by rfl)

/-- Embed a Boolean result at its minimal K subsort, as Klean does. -/
def initialBoolState (b : SortBool) : SortGeneratedTopCell :=
  { k := { val := SortK.kseq ((@Inj.inj SortBool SortKItem) b) SortK.dotk }
    generatedCounter := { val := 0 } }

/-- The labelled K comparison rule is a constructor of generated Rewrites. -/
theorem less_than_root_is_klean_rewrite (i j : SortInt) :
    Rewrites
      (initialState
        (SortK7Exp.k7Lt
          ((@Inj.inj SortInt SortK7Exp) i)
          ((@Inj.inj SortInt SortK7Exp) j)))
      (initialBoolState (i < j)) := by
  exact Rewrites.k7LessThanEval
    (I := i) (J := j) (_Val0 := i < j)
    (_DotVar0 := ⟨0⟩) (_DotVar1 := SortK.dotk)
    (by rfl)

/-- The true branch of K's conditional rule is represented by the generated rewrite. -/
theorem select_true_root_is_klean_rewrite (thenExpr elseExpr : SortK7Exp) :
    Rewrites
      (initialState
        (SortK7Exp.k7Select
          (SortK7Exp.inj_SortBool true) thenExpr elseExpr))
      (initialState thenExpr) := by
  exact Rewrites.k7SelectTrue

/-- The false branch of K's conditional rule is represented by the generated rewrite. -/
theorem select_false_root_is_klean_rewrite (thenExpr elseExpr : SortK7Exp) :
    Rewrites
      (initialState
        (SortK7Exp.k7Select
          (SortK7Exp.inj_SortBool false) thenExpr elseExpr))
      (initialState elseExpr) := by
  exact Rewrites.k7SelectFalse

#print axioms K7PL.Bridge.add_root_is_klean_rewrite
#print axioms K7PL.Bridge.less_than_root_is_klean_rewrite
#print axioms K7PL.Bridge.select_true_root_is_klean_rewrite
#print axioms K7PL.Bridge.select_false_root_is_klean_rewrite

end K7PL.Bridge
