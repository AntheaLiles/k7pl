;;; Lexical classes of the reader
;; After `expect:`, the class the tree reader gives each atom of the line, in order.

;;;; Numbers (Q-NUM-105)
[42 -2 3.25 1.5e-3 1_000_000] ;; expect: Number Number Number Number Number
[1/3 3+4i -1.5-2i inf -inf nan] ;; expect: Number Number Number Number Number Number

;;;; Trains of glyphs (Q-LEX-201)
[+ - +´÷≠ <= ≠¨] ;; expect: Train Train Train Train Train

;;;; Symbols, read whole (Q-LEX-201, Q-LEX-102, Q-LEX-105)
[increase-counter x-1 ^= ?pure !impure :label @linear #comptime] ;; expect: Symbol Symbol Symbol Symbol Symbol Symbol Symbol Symbol
[1__0 0x1F infinity a; a;b] ;; expect: Symbol Symbol Symbol Symbol Symbol Symbol

;;;; Strings, which may span lines (Q-STR-103)
["text" "two
lines"] ;; expect: String String
